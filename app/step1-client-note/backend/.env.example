# Copy this file to a new file named .env in this same folder, then paste your own key after the = sign.
# Get a key at https://huggingface.co/settings/tokens (type: Fine-grained, tick "Make calls to Inference Providers").
# Never share .env and never commit it. Git is told to ignore it.
HF_TOKEN=

# Anthropic key. Used for drafting the new-client note from the transcript, reading documents,
# and drafting existing-client updates from typed notes (backend/ai_client.py draft_update()).
# Get a key at https://console.anthropic.com/settings/keys
# Leave empty to keep the sample note and the sample update.
ANTHROPIC_API_KEY=
# Optional. Model for typed updates only. Defaults to claude-sonnet-5-5 if left blank.
ANTHROPIC_MODEL=
